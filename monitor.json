name: AH-Cross Monitor Live Mirror V2

on:
  workflow_dispatch:
  schedule:
    - cron: "7,22,37,52 * * * *"

permissions:
  contents: write

concurrency:
  group: ah-cross-monitor-live-v2
  cancel-in-progress: true

env:
  SOURCE_URL: "https://ah-cross-autolearn-production-4c96.up.railway.app/monitor.txt"
  EXPECTED_MODEL_VERSION: "0.4.0"
  EXPECTED_BUILD: "V0.4.0-YDC2"

jobs:
  mirror:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Checkout mirror repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Fetch Railway monitor
        shell: bash
        run: |
          set -euo pipefail
          NONCE="$(date +%s)"
          curl \
            --fail \
            --silent \
            --show-error \
            --location \
            --retry 5 \
            --retry-all-errors \
            --retry-delay 3 \
            --connect-timeout 10 \
            --max-time 45 \
            "${SOURCE_URL}?nonce=${NONCE}" \
            -o monitor-source.json
          printf '%s\n' "$NONCE" > nonce.txt

      - name: Validate and build safe live snapshot
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          import json, os
          from datetime import datetime, timezone
          from pathlib import Path

          src = json.loads(Path("monitor-source.json").read_text(encoding="utf-8"))
          expected_version = os.environ["EXPECTED_MODEL_VERSION"]
          expected_build = os.environ["EXPECTED_BUILD"]

          required = (
              "model_version", "build", "overall_status", "database",
              "scheduler", "official_final_counts"
          )
          missing = [k for k in required if k not in src]
          if missing:
              raise SystemExit(f"monitor payload missing required keys: {missing}")
          if str(src.get("model_version")) != expected_version:
              raise SystemExit(f"unexpected model_version: {src.get('model_version')!r}")
          if str(src.get("build")) != expected_build:
              raise SystemExit(f"unexpected build: {src.get('build')!r}")

          db = src.get("database") or {}
          if not db.get("connected"):
              raise SystemExit("database not connected")
          if db.get("backend") != "postgresql" or not db.get("persistent"):
              raise SystemExit(f"database persistence guard failed: {db}")

          mirrored_at = datetime.now(timezone.utc).isoformat()
          nonce = Path("nonce.txt").read_text(encoding="utf-8").strip()

          # Explicit allow-list. Never mirror arbitrary future production fields.
          safe = {
              "mirror_kind": "AH-Cross public read-only live monitor V2",
              "mirror_nonce": nonce,
              "mirrored_at": mirrored_at,
              "source_generated_at": src.get("generated_at"),
              "model_version": src.get("model_version"),
              "build": src.get("build"),
              "overall_status": src.get("overall_status"),
              "database": src.get("database"),
              "scheduler": src.get("scheduler"),
              "official_final_counts": src.get("official_final_counts"),
              "performance": src.get("performance"),
              "post_match_learning": src.get("post_match_learning"),
              "frozen_rules_integrity": src.get("frozen_rules_integrity"),
              "daily_requests": src.get("daily_requests"),
          }

          Path("snapshot.json").write_text(
              json.dumps(safe, ensure_ascii=False, indent=2) + "\n",
              encoding="utf-8",
          )

          status = {
              "mirror_nonce": nonce,
              "mirrored_at": mirrored_at,
              "source_generated_at": safe["source_generated_at"],
              "model_version": safe["model_version"],
              "build": safe["build"],
              "overall_status": safe["overall_status"],
              "database": {
                  "connected": db.get("connected"),
                  "backend": db.get("backend"),
                  "persistent": db.get("persistent"),
                  "guard": db.get("guard"),
              },
              "official_final_counts": safe["official_final_counts"],
          }
          Path("status.json").write_text(
              json.dumps(status, ensure_ascii=False, separators=(",", ":")) + "\n",
              encoding="utf-8",
          )

          lines = [
              "AH-Cross V0.4.0-YDC2 live monitor V2",
              f"mirror_nonce={nonce}",
              f"mirrored_at={mirrored_at}",
              f"source_generated_at={safe['source_generated_at']}",
              f"model_version={safe['model_version']}",
              f"build={safe['build']}",
              f"overall_status={safe['overall_status']}",
              "official_final_counts=" + json.dumps(safe["official_final_counts"], ensure_ascii=False),
          ]
          Path("chatgpt.txt").write_text("\n".join(lines) + "\n", encoding="utf-8")
          PY
          rm -f monitor-source.json

      - name: Publish machine-readable live branch
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p /tmp/ahcross-live
          cp chatgpt.txt /tmp/ahcross-live/chatgpt.txt
          cp snapshot.json /tmp/ahcross-live/snapshot.json
          cp status.json /tmp/ahcross-live/status.json
          cp nonce.txt /tmp/ahcross-live/nonce.txt

          git config user.name "ah-cross-monitor-bot"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git checkout --orphan live-v2
          git rm -rf . >/dev/null 2>&1 || true
          rm -rf .github README.md monitor.json health.json 2>/dev/null || true

          cp /tmp/ahcross-live/chatgpt.txt .
          cp /tmp/ahcross-live/snapshot.json .
          cp /tmp/ahcross-live/status.json .
          cp /tmp/ahcross-live/nonce.txt .

          git add chatgpt.txt snapshot.json status.json nonce.txt
          git commit -m "Update AH-Cross live monitor V2"
          git push origin HEAD:live --force
